# DeepSeek API (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Chain
XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
XLAYER_CHAIN_ID=1952
ORACLE_CONTRACT_ADDRESS=
RESOLVER_PRIVATE_KEY=

# Evidence sources
# SPORTS_DATA_API_KEY — still needed once a real sports provider is picked (see oracle-engine/src/evidence/sports.ts TODO).
# CRYPTO_PRICE_API_KEY — no longer needed. Crypto evidence now comes from CoinGecko + Binance's public keyless APIs.
SPORTS_DATA_API_KEY=
CRYPTO_PRICE_API_KEY=

# Set to "true" to run entirely on canned fixtures — no API key, no funded
# wallet, no live network calls. Used for judge-facing demos.
MOCK_MODE=true
